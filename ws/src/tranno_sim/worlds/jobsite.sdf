<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="jobsite">

    <physics name="default" type="dartsim">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.75 0.95 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.87 0.8 1</diffuse>
      <direction>-0.4 0.3 -0.8</direction>
    </light>

    <!-- ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.45 0.40 0.33 1</ambient><diffuse>0.5 0.45 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- rough patches: shallow ramps and bumps on the route -->
    <model name="bump1">
      <static>true</static>
      <pose>3.0 0.3 0.02 0 0 0.4</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.6 0.5 0.06</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.6 0.5 0.06</size></box></geometry>
      <material><ambient>0.35 0.3 0.24 1</ambient><diffuse>0.4 0.34 0.27 1</diffuse></material></visual></link>
    </model>
    <model name="bump2">
      <static>true</static>
      <pose>6.5 -2.0 0.025 0 0 -0.5</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.2 0.6 0.08</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.2 0.6 0.08</size></box></geometry>
      <material><ambient>0.35 0.3 0.24 1</ambient><diffuse>0.4 0.34 0.27 1</diffuse></material></visual></link>
    </model>

    <!-- obstacle on the route -->
    <model name="obstacle_scrap">
      <static>true</static>
      <pose>4.2 1.0 0.09 0 0 0.3</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.9 0.25 0.18</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.9 0.25 0.18</size></box></geometry>
      <material><ambient>0.30 0.22 0.12 1</ambient><diffuse>0.36 0.27 0.15 1</diffuse></material></visual></link>
    </model>

    <!-- material pile (where stacks come from) -->
    <model name="pile">
      <static>true</static>
      <pose>-1.5 2.0 0 0 0 0.2</pose>
      <link name="l">
        <collision name="c1"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>1.2 0.8 0.3</size></box></geometry></collision>
        <visual name="v1"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>1.2 0.8 0.3</size></box></geometry>
          <material><ambient>0.45 0.32 0.16 1</ambient><diffuse>0.55 0.38 0.19 1</diffuse></material></visual>
        <visual name="v2"><pose>0 0 0.38 0 0 0.1</pose><geometry><box><size>1.0 0.7 0.16</size></box></geometry>
          <material><ambient>0.5 0.36 0.18 1</ambient><diffuse>0.6 0.42 0.21 1</diffuse></material></visual>
      </link>
    </model>

    <!-- drop zone marker -->
    <model name="drop_zone">
      <static>true</static>
      <pose>8.0 -2.5 0.006 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>1.2 0.9 0.012</size></box></geometry>
          <material><ambient>1.0 0.48 0.10 1</ambient><diffuse>1.0 0.48 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== T-01 robot ===================== -->
    <model name="t01">
      <pose>0 0 0.32 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>90</mass>
          <inertia><ixx>4.0</ixx><iyy>8.0</iyy><izz>10.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.95 0.60 0.24</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.95 0.60 0.24</size></box></geometry>
          <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.13 0.13 0.16 1</diffuse></material>
        </visual>
        <visual name="stripe">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.96 0.61 0.03</size></box></geometry>
          <material><ambient>1.0 0.48 0.10 1</ambient><diffuse>1.0 0.48 0.10 1</diffuse></material>
        </visual>
      </link>

      <!-- mast + camera -->
      <link name="camera_link">
        <pose>0.42 0 0.45 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.08 0.10 0.08</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.1 1</diffuse></material></visual>
        <sensor name="front_cam" type="camera">
          <topic>front_cam</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>640</width><height>360</height></image>
            <clip><near>0.05</near><far>60</far></clip>
          </camera>
        </sensor>
      </link>
      <joint name="camera_joint" type="fixed">
        <parent>chassis</parent><child>camera_link</child>
      </joint>

      <!-- lift carriage -->
      <link name="lift_link">
        <pose>0 0 0.17 0 0 0</pose>
        <inertial>
          <mass>6</mass>
          <inertia><ixx>0.2</ixx><iyy>0.35</iyy><izz>0.5</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.70 0.45 0.03</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.70 0.45 0.03</size></box></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>
      <joint name="lift_joint" type="prismatic">
        <parent>chassis</parent><child>lift_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>0.45</upper><effort>8000</effort><velocity>0.4</velocity></limit>
          <dynamics><damping>200</damping></dynamics>
        </axis>
      </joint>
      <!-- tilt deck (dump) on top of the carriage; hinge at the rear edge -->
      <link name="tilt_deck">
        <pose>0 0 0.215 0 0 0</pose>
        <inertial>
          <mass>8</mass>
          <inertia><ixx>0.25</ixx><iyy>0.45</iyy><izz>0.65</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.80 0.55 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.80 0.55 0.04</size></box></geometry>
          <material><ambient>0.16 0.16 0.19 1</ambient><diffuse>0.2 0.2 0.24 1</diffuse></material></visual>
      </link>
      <joint name="tilt_joint" type="revolute">
        <parent>lift_link</parent><child>tilt_deck</child>
        <pose>-0.38 0 -0.02 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.7</lower><upper>0</upper><effort>4000</effort><velocity>0.8</velocity></limit>
          <dynamics><damping>60</damping></dynamics>
        </axis>
      </joint>

      <!-- wheels (skid-steer approximation of tracks) -->
      <link name="wheel_fl"><pose>0.32 0.36 -0.14 -1.5707 0 0</pose>
        <inertial><mass>6</mass><inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
      </link>
      <link name="wheel_fr"><pose>0.32 -0.36 -0.14 -1.5707 0 0</pose>
        <inertial><mass>6</mass><inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
      </link>
      <link name="wheel_rl"><pose>-0.32 0.36 -0.14 -1.5707 0 0</pose>
        <inertial><mass>6</mass><inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
      </link>
      <link name="wheel_rr"><pose>-0.32 -0.36 -0.14 -1.5707 0 0</pose>
        <inertial><mass>6</mass><inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse></material></visual>
      </link>

      <joint name="wheel_fl_joint" type="revolute">
        <parent>chassis</parent><child>wheel_fl</child>
        <axis><xyz>0 0 1</xyz><limit><effort>400</effort></limit></axis>
      </joint>
      <joint name="wheel_fr_joint" type="revolute">
        <parent>chassis</parent><child>wheel_fr</child>
        <axis><xyz>0 0 1</xyz><limit><effort>400</effort></limit></axis>
      </joint>
      <joint name="wheel_rl_joint" type="revolute">
        <parent>chassis</parent><child>wheel_rl</child>
        <axis><xyz>0 0 1</xyz><limit><effort>400</effort></limit></axis>
      </joint>
      <joint name="wheel_rr_joint" type="revolute">
        <parent>chassis</parent><child>wheel_rr</child>
        <axis><xyz>0 0 1</xyz><limit><effort>400</effort></limit></axis>
      </joint>

      <!-- drive: skid steer via diff drive on both wheel pairs -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_fl_joint</left_joint>
        <left_joint>wheel_rl_joint</left_joint>
        <right_joint>wheel_fr_joint</right_joint>
        <right_joint>wheel_rr_joint</right_joint>
        <wheel_separation>0.72</wheel_separation>
        <wheel_radius>0.18</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <max_linear_acceleration>1.0</max_linear_acceleration>
      </plugin>

      <!-- lift control -->
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>lift_joint</joint_name>
        <topic>/lift_cmd</topic>
        <p_gain>6000</p_gain>
        <d_gain>300</d_gain>
        <i_gain>10</i_gain>
      </plugin>

      <!-- tilt control -->
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>tilt_joint</joint_name>
        <topic>/tilt_cmd</topic>
        <p_gain>3000</p_gain>
        <d_gain>150</d_gain>
      </plugin>

      <!-- true model pose (OdometryPublisher integrates velocity and drifts; this does not) -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <static_publisher>false</static_publisher>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>

      <!-- payload attach/detach -->
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>tilt_deck</parent_link>
        <child_model>cedar_stack</child_model>
        <child_link>stack_link</child_link>
        <detach_topic>/detach</detach_topic>
      </plugin>
    </model>

    <!-- cedar stack payload, starts attached to the lift deck -->
    <model name="cedar_stack">
      <pose>0 0 0.75 0 0 0</pose>
      <link name="stack_link">
        <inertial>
          <mass>60</mass>
          <inertia><ixx>1.2</ixx><iyy>2.6</iyy><izz>3.2</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.80 0.50 0.36</size></box></geometry>
          <surface><friction><ode><mu>0.35</mu><mu2>0.35</mu2></ode></friction></surface></collision>
        <visual name="v1"><pose>0 0 -0.12 0 0 0</pose><geometry><box><size>0.80 0.50 0.12</size></box></geometry>
          <material><ambient>0.42 0.29 0.13 1</ambient><diffuse>0.52 0.36 0.16 1</diffuse></material></visual>
        <visual name="v2"><pose>0 0 0.0 0 0 0</pose><geometry><box><size>0.76 0.48 0.12</size></box></geometry>
          <material><ambient>0.48 0.33 0.15 1</ambient><diffuse>0.58 0.40 0.18 1</diffuse></material></visual>
        <visual name="v3"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.72 0.46 0.12</size></box></geometry>
          <material><ambient>0.52 0.36 0.17 1</ambient><diffuse>0.62 0.44 0.20 1</diffuse></material></visual>
        <visual name="strap1"><pose>0.2 0 0 0 0 0</pose><geometry><box><size>0.03 0.52 0.38</size></box></geometry>
          <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.33 1</diffuse></material></visual>
        <visual name="strap2"><pose>-0.2 0 0 0 0 0</pose><geometry><box><size>0.03 0.52 0.38</size></box></geometry>
          <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.33 1</diffuse></material></visual>
      </link>
    </model>


    <!-- ============ scenery pack (demo v2) ============ -->
    <model name="driveway">
      <static>true</static>
      <pose>-2.5 -0.9 0.004 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.0 2.6 0.008</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.0 2.6 0.008</size></box></geometry>
      <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.33 0.33 0.35 1</diffuse></material></visual></link>
    </model>
    <model name="truck_bed">
      <static>true</static>
      <pose>-2.1 -1.0 0.75 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.2 1.9 0.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.2 1.9 0.7</size></box></geometry>
      <material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.82 0.84 0.88 1</diffuse></material></visual></link>
    </model>
    <model name="truck_cab">
      <static>true</static>
      <pose>-3.75 -1.0 0.7 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.1 1.9 1.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.1 1.9 1.4</size></box></geometry>
      <material><ambient>0.82 0.30 0.16 1</ambient><diffuse>0.92 0.34 0.18 1</diffuse></material></visual></link>
    </model>
    <model name="fence_a">
      <static>true</static>
      <pose>5.0 1.3125 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.08 4.375 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.08 4.375 1.0</size></box></geometry>
      <material><ambient>0.42 0.30 0.18 1</ambient><diffuse>0.5 0.36 0.22 1</diffuse></material></visual></link>
    </model>
    <model name="fence_b">
      <static>true</static>
      <pose>5.0 -3.5125 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.08 2.975 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.08 2.975 1.0</size></box></geometry>
      <material><ambient>0.42 0.30 0.18 1</ambient><diffuse>0.5 0.36 0.22 1</diffuse></material></visual></link>
    </model>
    <model name="gate_post_a">
      <static>true</static>
      <pose>5.0 -0.875 0.55 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.14 0.14 1.1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.14 0.14 1.1</size></box></geometry>
      <material><ambient>0.32 0.22 0.12 1</ambient><diffuse>0.38 0.27 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="gate_post_b">
      <static>true</static>
      <pose>5.0 -2.025 0.55 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.14 0.14 1.1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.14 0.14 1.1</size></box></geometry>
      <material><ambient>0.32 0.22 0.12 1</ambient><diffuse>0.38 0.27 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="house_wall_a">
      <static>true</static>
      <pose>8.0 -4.3 1.15 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3.6 0.15 2.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.6 0.15 2.3</size></box></geometry>
      <material><ambient>0.82 0.78 0.70 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material></visual></link>
    </model>
    <model name="house_wall_b">
      <static>true</static>
      <pose>9.8 -2.95 1.15 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.15 2.7 2.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 2.7 2.3</size></box></geometry>
      <material><ambient>0.82 0.78 0.70 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material></visual></link>
    </model>
    <model name="pallet1">
      <static>true</static>
      <pose>1.6 1.7 0.06 0 0 0.15</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.0 0.8 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.0 0.8 0.12</size></box></geometry>
      <material><ambient>0.45 0.33 0.17 1</ambient><diffuse>0.55 0.40 0.20 1</diffuse></material></visual></link>
    </model>
    <model name="pallet2">
      <static>true</static>
      <pose>1.62 1.68 0.18 0 0 -0.1</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.0 0.8 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.0 0.8 0.12</size></box></geometry>
      <material><ambient>0.42 0.30 0.15 1</ambient><diffuse>0.52 0.37 0.18 1</diffuse></material></visual></link>
    </model>
    <model name="pallet3">
      <static>true</static>
      <pose>1.58 1.72 0.30 0 0 0.05</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.0 0.8 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.0 0.8 0.12</size></box></geometry>
      <material><ambient>0.45 0.33 0.17 1</ambient><diffuse>0.55 0.40 0.20 1</diffuse></material></visual></link>
    </model>
    <model name="gravel1">
      <static>true</static>
      <pose>0.5 -2.0 0.125 0 0 0.3</pose>
      <link name="l"><collision name="c"><geometry><box><size>1.2 0.9 0.25</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.2 0.9 0.25</size></box></geometry>
      <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.58 0.58 0.60 1</diffuse></material></visual></link>
    </model>
    <model name="gravel2">
      <static>true</static>
      <pose>0.8 -1.7 0.30 0 0 -0.2</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.8 0.6 0.16</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 0.6 0.16</size></box></geometry>
      <material><ambient>0.55 0.55 0.57 1</ambient><diffuse>0.62 0.62 0.64 1</diffuse></material></visual></link>
    </model>
    <model name="cone0">
      <static>true</static>
